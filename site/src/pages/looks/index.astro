---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Sparkle from '../../components/Sparkle.astro';
import {
  elementLabel,
  instagramPosts,
  resolveInstagramImage,
  similarToPost,
} from '../../lib/instagram';
import { LOOK_CATEGORIES, type LookCategory } from '../../lib/looks';

/**
 * Social-feed lookbook: an Instagram-style tile grid where every tile opens
 * an in-page modal (media carousel + caption + elements + recommendations),
 * navigable post to post like the feed it comes from. Progressive
 * enhancement throughout: without JavaScript the tiles anchor-jump to the
 * same detail blocks rendered at the end of the page (dialog:target), the
 * carousels swipe natively, and every post stays reachable.
 */
const gridCategories = (Object.keys(LOOK_CATEGORIES) as LookCategory[]).filter((category) =>
  instagramPosts.some((post) => post.category === category),
);
const categoryCounts = Object.fromEntries(
  gridCategories.map((category) => [
    category,
    instagramPosts.filter((post) => post.category === category).length,
  ]),
) as Record<LookCategory, number>;
const mediaCount = instagramPosts.reduce((total, post) => total + post.media.length, 0);

/** Element-tag recommendations shown inside each modal. */
const recommendationsById = new Map(
  instagramPosts.map((post) => [post.id, similarToPost(post, 3)]),
);

/**
 * Texture set for the optional WebGL gallery: square, modest, and built by
 * the same image pipeline as the grid, so the browser reuses what it can.
 */
const galleryLooks = await Promise.all(
  instagramPosts.map(async (post) => {
    const image = await getImage({
      src: resolveInstagramImage(post.media[0].src),
      width: 520,
      height: 520,
      format: 'webp',
      quality: 76,
    });
    return {
      id: post.id,
      src: image.src,
      title: post.title,
      category: LOOK_CATEGORIES[post.category],
      shoppable: Boolean(post.shopHref),
    };
  }),
);

const dateLabel = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title="Shop the Looks"
  description="Browse Susanne's real outfits like a feed: tap any look for the full caption, every carousel slide, detected style elements, and shoppable piece-by-piece edits."
>
  <!-- ============================================================ Hero -->
  <section class="looks-hero bg-blush-wash">
    <Sparkle size={22} top="12%" right="7%" delay={0.5} />
    <Sparkle size={14} top="34%" right="14%" gold delay={1.7} />
    <div class="container">
      <p class="eyebrow">Shop the looks</p>
      <h1>Real outfits, from my closet to <em class="serif-italic">yours</em></h1>
      <p class="lede">
        Every look starts on @styled.by.susanne: a real day, a real outfit,
        and the styling note that made it work. Tap any look for the full
        story, every carousel slide, and similar outfits matched by what's
        actually in the photo.
      </p>
      <p class="looks-disclosure">
        Honesty first: some of the product links on these pages are affiliate
        links, which means I may earn a small commission if you shop through
        them, at no extra cost to you. <a
          href="/policies/affiliate-disclosure">Here's exactly how that works</a>.
      </p>
    </div>
  </section>

  <!-- =============================================== Instagram lookbook -->
  <section class="section instagram-lookbook" id="instagram-lookbook">
    <div class="lookbook-toolbar" data-lookbook-toolbar>
      <div class="container">
        <div class="lookbook-toolbar-row">
          <div
            class="filter-chips"
            role="group"
            aria-label="Filter looks by category"
            data-instagram-filter-bar
            hidden
          >
            <button class="filter-chip" type="button" data-instagram-filter="all" aria-pressed="true">
              All looks <span class="filter-chip-count">{instagramPosts.length}</span>
            </button>
            {
              gridCategories.map((category) => (
                <button
                  class="filter-chip"
                  type="button"
                  data-instagram-filter={category}
                  aria-pressed="false"
                >
                  {LOOK_CATEGORIES[category]}
                  <span class="filter-chip-count">{categoryCounts[category]}</span>
                </button>
              ))
            }
          </div>
          <div class="lookbook-toolbar-end">
            {/* Shown only once the WebGL view is confirmed available. */}
            <div class="view-switch" role="group" aria-label="Lookbook view" data-view-switch hidden>
              <button type="button" data-view="grid" aria-pressed="true">Grid</button>
              <button type="button" data-view="gallery" aria-pressed="false">Gallery</button>
            </div>
            <p class="lookbook-count">
              <strong>{instagramPosts.length}</strong> posts ·
              <strong>{mediaCount}</strong> visuals
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================== WebGL gallery view -->
    <div class="container">
      <section class="rail" data-rail hidden aria-labelledby="rail-heading">
        <h3 class="visually-hidden" id="rail-heading">Gallery view</h3>
        <div class="rail-stage">
          <canvas
            class="rail-canvas"
            data-rail-canvas
            tabindex="0"
            role="application"
            aria-label="Look gallery. Use the left and right arrow keys to move between looks, Enter to open the centred look."
          ></canvas>
          <p class="rail-loading" data-rail-loading>Warming up the rail…</p>
          <button
            class="rail-arrow rail-arrow--prev"
            type="button"
            data-rail-prev
            aria-label="Previous look"
          >
            ←
          </button>
          <button
            class="rail-arrow rail-arrow--next"
            type="button"
            data-rail-next
            aria-label="Next look"
          >
            →
          </button>

          <button
            class="rail-expand"
            type="button"
            data-rail-expand
            aria-pressed="false"
            aria-label="Fill the screen"
          >
            <span data-rail-expand-label>Fill the screen</span>
          </button>

          {/* Immersive only: swipe up (or tap) for the full story. */}
          <div class="rail-sheet" data-rail-sheet>
            <button
              class="rail-sheet-tab"
              type="button"
              data-rail-sheet-toggle
              aria-expanded="false"
              aria-controls="rail-sheet-body"
            >
              <span class="rail-sheet-grip" aria-hidden="true"></span>
              <span class="rail-sheet-hint" data-rail-sheet-hint>
                Swipe up for the details
              </span>
            </button>
            <div class="rail-sheet-body" id="rail-sheet-body" data-rail-sheet-body>
              <p class="rail-sheet-meta" data-sheet-meta></p>
              <p class="rail-sheet-title" data-sheet-title></p>
              <p class="rail-sheet-caption" data-sheet-caption></p>
              <ul class="rail-sheet-elements" role="list" data-sheet-elements></ul>
              <div class="rail-sheet-actions">
                <a class="btn btn--rose rail-sheet-shop" data-sheet-shop hidden>
                  Shop this look
                </a>
                <a
                  class="rail-sheet-ig"
                  data-sheet-ig
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View on Instagram <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="rail-caption">
          <p class="rail-position" data-rail-position></p>
          <p class="rail-title" data-rail-title></p>
          <div class="rail-actions">
            <button class="btn btn--rose rail-open" type="button" data-rail-open>
              Open this look
            </button>
          </div>
          <p class="rail-hint">
            Drag the rail, or use the arrow keys. Tap a look to bring it forward.
          </p>
        </div>
        <p class="visually-hidden" role="status" data-rail-status></p>
      </section>
      <script
        id="rail-data"
        type="application/json"
        set:html={JSON.stringify(galleryLooks)}
      />
    </div>

    <div class="container">
      <p class="visually-hidden" role="status" data-instagram-filter-status></p>

      <ul class="feed-grid" role="list">
        {
          instagramPosts.map((post, index) => (
            <li data-instagram-category={post.category} data-tile={post.id}>
              <a
                class="feed-tile"
                href={`#post-${post.id}`}
                aria-label={`Open look: ${post.title}`}
              >
                <Image
                  src={resolveInstagramImage(post.media[0].src)}
                  alt={post.media[0].alt}
                  widths={[320, 480, 700]}
                  sizes="(max-width: 980px) 33vw, 310px"
                  loading={index < 6 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                <span class="feed-tile-badges" aria-hidden="true">
                  {post.media.length > 1 && (
                    <svg class="feed-tile-stack" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 3h11a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-1V6a2 2 0 0 0-2-2H8V4a1 1 0 0 1 1-1Z" />
                      <rect x="3" y="7" width="14" height="14" rx="1.5" />
                    </svg>
                  )}
                  {post.kind === 'reel' && <span class="feed-tile-tag">Reel</span>}
                </span>
                {post.shopHref && <span class="feed-tile-shop" aria-hidden="true">Shop</span>}
                <span class="feed-tile-hover" aria-hidden="true">
                  View look <span class="feed-tile-arrow">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="lookbook-more">
        <div data-feed-sentinel aria-hidden="true"></div>
        <button class="btn btn--outline" type="button" data-show-more hidden>
          Show more looks
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================= From my closet to yours -->
  <section class="section section--ivory looks-outro">
    <div class="container container--narrow text-center">
      <p class="eyebrow eyebrow--center">Beyond the links</p>
      <h2>Want this taste applied to <em class="serif-italic">your</em> closet?</h2>
      <p class="lede looks-outro-lede">
        Shopping my looks is the free sample. The real magic is opening your
        own closet and finding outfits like these already built; that's what
        my styling services are for. And if you'd like pieces like these
        sourced for your life (not mine) all year round, that's literally the
        Digital Stylist's job.
      </p>
      <div class="looks-outro-actions">
        <a class="btn btn--primary" href="/services">Explore Styling Services</a>
        <a class="btn btn--outline" href="/services/ongoing-styling">Meet the Digital Stylist</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Let's find out what your version of these looks like"
    secondaryLabel="Browse Styling Services"
    secondaryHref="/services"
  />

  <!-- ================================================== Post modals -->
  {
    instagramPosts.map((post) => (
      <dialog
        class="post-modal"
        id={`post-${post.id}`}
        data-post-modal={post.id}
        aria-label={`Look from ${dateLabel(post.date)}: ${post.title}`}
      >
        <a class="post-modal-close" href="#instagram-lookbook" data-modal-close aria-label="Close look">
          ✕
        </a>

        <article class="post-modal-body">
          <div class="post-modal-media" data-instagram-gallery>
            <div
              class="post-modal-track"
              data-gallery-track
              tabindex={post.media.length > 1 ? 0 : undefined}
              role={post.media.length > 1 ? 'group' : undefined}
              aria-label={post.media.length > 1 ? `${post.media.length} photos` : undefined}
            >
              {post.media.map((media) => (
                <figure class="post-modal-slide">
                  <Image
                    src={resolveInstagramImage(media.src)}
                    alt={media.alt}
                    widths={[480, 720, 1080]}
                    sizes="(max-width: 900px) 100vw, 54vw"
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
            {/* Mobile affordances: where you are in the feed, and a first-run
                nudge that swiping moves between looks. */}
            <span class="post-modal-position" data-modal-position aria-hidden="true"></span>
            <p class="swipe-hint" data-swipe-hint aria-hidden="true">
              <span aria-hidden="true">←</span> Swipe between looks
              <span aria-hidden="true">→</span>
            </p>

            {post.media.length > 1 && (
              <>
                <button class="gallery-nav gallery-nav--prev" type="button" data-gallery-previous aria-label="Previous photo" disabled>
                  ←
                </button>
                <button class="gallery-nav gallery-nav--next" type="button" data-gallery-next aria-label="Next photo">
                  →
                </button>
                <div class="gallery-dots" data-gallery-dots aria-hidden="true">
                  {post.media.map((_, index) => (
                    <span class:list={['gallery-dot', { 'is-active': index === 0 }]} />
                  ))}
                </div>
                <span class="gallery-count" data-gallery-count>
                  1 / {post.media.length}
                </span>
              </>
            )}
          </div>

          <div class="post-modal-panel">
            <header class="post-modal-head">
              <p class="post-modal-kicker">
                {LOOK_CATEGORIES[post.category]}
                {post.kind === 'reel' && <span class="post-modal-reel">Reel</span>}
              </p>
              <p class="post-modal-meta">
                <time datetime={post.date}>{dateLabel(post.date)}</time>
                {post.location && <span> · {post.location}</span>}
              </p>
              {/* Fixed beside the dialog on desktop, in-flow on mobile. */}
              <div class="post-modal-steps">
                <button
                  class="post-modal-nav post-modal-nav--prev"
                  type="button"
                  data-modal-prev
                  aria-label="Previous look"
                >
                  ←
                </button>
                <button
                  class="post-modal-nav post-modal-nav--next"
                  type="button"
                  data-modal-next
                  aria-label="Next look"
                >
                  →
                </button>
              </div>
            </header>

            <details class="post-modal-caption">
              <summary>{post.title}</summary>
              <p>{post.caption}</p>
            </details>

            {post.elements.length > 0 && (
              <ul class="post-modal-elements" role="list" aria-label="In this look">
                {post.elements.slice(0, 10).map((tag) => (
                  <li>{elementLabel(tag)}</li>
                ))}
              </ul>
            )}

            <div class="post-modal-actions">
              {post.shopHref && (
                <a class="btn btn--rose post-modal-shop" href={post.shopHref}>
                  Shop this look<span class="post-modal-shop-tail"> piece by piece</span>
                </a>
              )}
              <a
                class="post-modal-source"
                href={post.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on Instagram <span aria-hidden="true">↗</span>
              </a>
            </div>

            {(recommendationsById.get(post.id) ?? []).length > 0 && (
              <div class="post-modal-related">
                <p class="post-modal-related-title">More like this</p>
                <ul role="list">
                  {(recommendationsById.get(post.id) ?? []).map(({ post: related, shared }) => (
                    <li>
                      <a href={`#post-${related.id}`} class="post-modal-related-card">
                        <span class="post-modal-related-thumb">
                          <Image
                            src={resolveInstagramImage(related.media[0].src)}
                            alt={related.media[0].alt}
                            widths={[120, 240]}
                            sizes="72px"
                            loading="lazy"
                          />
                        </span>
                        <span class="post-modal-related-text">
                          <span class="post-modal-related-label">
                            {shared.slice(0, 3).map(elementLabel).join(' · ')}
                          </span>
                          <span class="post-modal-related-name">{related.title}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      </dialog>
    ))
  }
</Base>

<script>
  // Progressive enhancement: without JavaScript every tile anchor-jumps to
  // its detail block (dialog:target renders it in-flow), carousels swipe
  // via scroll-snap, and the grid shows every post.

  /* ------------------------------- category filter + feed batching */
  const BATCH = 15;
  const bar = document.querySelector<HTMLElement>('[data-instagram-filter-bar]');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('li[data-tile]'));
  const status = document.querySelector<HTMLElement>('[data-instagram-filter-status]');
  const moreButton = document.querySelector<HTMLButtonElement>('[data-show-more]');
  const sentinel = document.querySelector<HTMLElement>('[data-feed-sentinel]');

  let activeFilter = 'all';
  let visibleCap = BATCH;

  const matching = () =>
    items.filter(
      (item) => activeFilter === 'all' || item.dataset.instagramCategory === activeFilter,
    );

  const apply = () => {
    const matches = matching();
    for (const item of items) item.hidden = true;
    matches.forEach((item, index) => {
      item.hidden = index >= visibleCap;
    });

    const shown = Math.min(visibleCap, matches.length);
    const remaining = matches.length - shown;
    if (status) status.textContent = `Showing ${shown} of ${matches.length} looks`;
    if (moreButton) {
      moreButton.hidden = remaining <= 0;
      moreButton.textContent = `Show ${Math.min(BATCH, remaining)} more looks (${remaining} left)`;
    }
  };

  if (bar && items.length) {
    bar.hidden = false;
    const chips = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('button[data-instagram-filter]'),
    );
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeFilter = chip.dataset.instagramFilter ?? 'all';
        visibleCap = BATCH;
        for (const candidate of chips) {
          candidate.setAttribute('aria-pressed', String(candidate === chip));
        }
        apply();
      });
    }

    moreButton?.addEventListener('click', () => {
      visibleCap += BATCH;
      apply();
    });

    // Social-feed scrolling: quietly load the next batch as the visitor
    // approaches the end; the button stays as an accessible fallback.
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting) && !moreButton?.hidden) {
            visibleCap += BATCH;
            apply();
          }
        },
        { rootMargin: '600px 0px' },
      ).observe(sentinel);
    }

    apply();
  }

  /* --------------------------------------- swipeable media carousels */
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-instagram-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    if (!track || track.children.length < 2) continue;

    const slideCount = track.children.length;
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    const dots = Array.from(gallery.querySelector<HTMLElement>('[data-gallery-dots]')?.children ?? []);

    let active = 0;
    const render = () => {
      if (previous) previous.disabled = active === 0;
      if (next) next.disabled = active === slideCount - 1;
      if (count) count.textContent = `${active + 1} / ${slideCount}`;
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active));
    };

    const goTo = (index: number) => {
      const clamped = Math.min(slideCount - 1, Math.max(0, index));
      // Update immediately rather than waiting on the debounced scroll
      // listener: smooth scrolling can be interrupted, and the controls
      // should never lag behind the tap.
      active = clamped;
      render();
      track.scrollTo({ left: clamped * track.clientWidth, behavior: 'smooth' });
    };

    previous?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));

    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          const index = Math.round(track.scrollLeft / track.clientWidth);
          if (index !== active) {
            active = Math.min(slideCount - 1, Math.max(0, index));
            render();
          }
        }, 80);
      },
      { passive: true },
    );

    render();
  }

  /* -------------------------------------------------- post modals */
  const modals = new Map(
    Array.from(document.querySelectorAll<HTMLDialogElement>('[data-post-modal]')).map(
      (modal) => [modal.dataset.postModal!, modal],
    ),
  );
  let openId: string | null = null;

  const orderedIds = () => matching().map((item) => item.dataset.tile!);

  const revealTile = (id: string) => {
    const tile = document.querySelector<HTMLLIElement>(`li[data-tile="${id}"]`);
    if (!tile) return;
    const matches = matching();
    const index = matches.indexOf(tile);
    if (index >= 0 && index >= visibleCap) {
      visibleCap = index + 1;
      apply();
    }
  };

  const setHash = (hash: string) => {
    // pushState instead of location.hash: no native scroll jump.
    history.pushState(null, '', hash || location.pathname);
  };

  /**
   * Teardown for whichever post is showing. Idempotent and keyed by id, so
   * a late `close` event from a modal we already navigated away from is a
   * no-op. Not driven by the `close` event alone: some engines do not fire
   * it for programmatic close(), which would strand the scroll lock.
   */
  const cleanupAfterClose = (id: string, restoreScroll = true) => {
    if (openId !== id) return;
    openId = null;
    document.documentElement.classList.remove('modal-open');
    setHash('');
    if (!restoreScroll) return;
    const tile = document.querySelector(`li[data-tile="${id}"] a`);
    const rect = tile?.getBoundingClientRect();
    if (tile && rect && (rect.bottom < 0 || rect.top > window.innerHeight)) {
      tile.scrollIntoView({ block: 'center' });
    }
  };

  const closeModal = () => {
    if (!openId) return;
    const id = openId;
    modals.get(id)?.close();
    cleanupAfterClose(id);
  };

  /**
   * Teach the swipe once per visit, on touch screens only, and never again
   * after the visitor has actually swiped.
   */
  const HINT_KEY = 'sbs-swipe-hint-seen';
  let hintTimer = 0;
  const hintSeen = () => {
    try {
      return sessionStorage.getItem(HINT_KEY) === '1';
    } catch {
      return true;
    }
  };
  const retireHint = () => {
    try {
      sessionStorage.setItem(HINT_KEY, '1');
    } catch {
      /* private mode: the hint simply shows again next open */
    }
    for (const hint of document.querySelectorAll('[data-swipe-hint]')) {
      hint.classList.remove('is-shown');
    }
  };
  const showSwipeHint = (modal: HTMLDialogElement) => {
    if (hintSeen() || !window.matchMedia('(hover: none)').matches) return;
    const hint = modal.querySelector<HTMLElement>('[data-swipe-hint]');
    if (!hint) return;
    hint.classList.add('is-shown');
    window.clearTimeout(hintTimer);
    hintTimer = window.setTimeout(retireHint, 3200);
  };

  /** 0 opens fresh, 1 arrives from the right, -1 from the left. */
  const openModal = (id: string, updateHash = true, direction = 0) => {
    const modal = modals.get(id);
    if (!modal) return;
    if (openId && openId !== id) modals.get(openId)?.close();
    openId = id;

    const body = modal.querySelector<HTMLElement>('.post-modal-body');
    if (body) {
      // Restart the animation on every open, including post-to-post steps.
      body.removeAttribute('data-enter');
      void body.offsetWidth;
      body.dataset.enter = direction > 0 ? 'right' : direction < 0 ? 'left' : 'open';
    }
    if (!modal.open) modal.showModal();
    document.documentElement.classList.add('modal-open');
    revealTile(id);
    if (updateHash) setHash(`#post-${id}`);

    const ids = orderedIds();
    const index = ids.indexOf(id);
    const prev = modal.querySelector<HTMLButtonElement>('[data-modal-prev]');
    const next = modal.querySelector<HTMLButtonElement>('[data-modal-next]');
    if (prev) prev.disabled = index <= 0;
    if (next) next.disabled = index === -1 || index >= ids.length - 1;

    // Position within the current (possibly filtered) set.
    const position = modal.querySelector<HTMLElement>('[data-modal-position]');
    if (position) position.textContent = `${index + 1} / ${ids.length}`;

    showSwipeHint(modal);
  };

  const step = (direction: number) => {
    if (!openId) return;
    const ids = orderedIds();
    const target = ids[ids.indexOf(openId) + direction];
    if (target) openModal(target, true, direction);
  };

  /* --------------------------------- touch: swipe posts, drag to dismiss */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const compact = window.matchMedia('(max-width: 900px)');
  const SWIPE_DISTANCE = 45;
  const DISMISS_DISTANCE = 100;

  const addTouchGestures = (modal: HTMLDialogElement) => {
    const body = modal.querySelector<HTMLElement>('.post-modal-body');
    if (!body) return;

    let startX = 0;
    let startY = 0;
    let dx = 0;
    let dy = 0;
    let axis: 'x' | 'y' | null = null;
    let tracking = false;

    body.addEventListener(
      'touchstart',
      (event) => {
        if (!compact.matches || event.touches.length !== 1) return;
        const touch = event.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        dx = 0;
        dy = 0;
        axis = null;
        tracking = true;
        body.style.transition = 'none';
      },
      { passive: true },
    );

    body.addEventListener(
      'touchmove',
      (event) => {
        if (!tracking) return;
        const touch = event.touches[0];
        dx = touch.clientX - startX;
        dy = touch.clientY - startY;

        if (!axis) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
          axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';

          if (axis === 'x') {
            // A carousel with room left in the swipe direction keeps the
            // gesture: only at its edges does a swipe change posts.
            const track = (event.target as HTMLElement).closest<HTMLElement>(
              '[data-gallery-track]',
            );
            const canScrollBack = track ? track.scrollLeft > 2 : false;
            const canScrollOn = track
              ? track.scrollLeft < track.scrollWidth - track.clientWidth - 2
              : false;
            if ((dx > 0 && canScrollBack) || (dx < 0 && canScrollOn)) {
              tracking = false;
              return;
            }
          } else {
            // Drag down to dismiss, but only from the top of the panel so
            // it never fights reading the caption.
            const panel = (event.target as HTMLElement).closest<HTMLElement>(
              '.post-modal-panel',
            );
            if (dy < 0 || (panel && panel.scrollTop > 0)) {
              tracking = false;
              return;
            }
          }
        }

        if (reduced.matches) return;
        body.style.transform =
          axis === 'x'
            ? `translateX(${dx * 0.35}px)`
            : `translateY(${Math.max(0, dy) * 0.55}px)`;
        if (axis === 'y') {
          body.style.opacity = String(Math.max(0.55, 1 - dy / 500));
        }
      },
      { passive: true },
    );

    const release = () => {
      if (!tracking) return;
      tracking = false;
      body.style.transition = '';
      body.style.transform = '';
      body.style.opacity = '';
      if (axis === 'x' && Math.abs(dx) > SWIPE_DISTANCE) {
        retireHint();
        step(dx < 0 ? 1 : -1);
      } else if (axis === 'y' && dy > DISMISS_DISTANCE) {
        closeModal();
      }
    };

    body.addEventListener('touchend', release, { passive: true });
    body.addEventListener('touchcancel', release, { passive: true });
  };

  for (const [id, modal] of modals) {
    // Escape and any other native dismissal land here.
    modal.addEventListener('close', () => cleanupAfterClose(id));
    modal.addEventListener('cancel', () => cleanupAfterClose(id));

    // Click on the backdrop (the dialog element itself) closes.
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modal.querySelector('[data-modal-prev]')?.addEventListener('click', () => step(-1));
    modal.querySelector('[data-modal-next]')?.addEventListener('click', () => step(1));
    addTouchGestures(modal);
  }

  // One delegated handler covers tiles, recommendation cards, and close
  // links, wherever they live.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const close = target.closest('[data-modal-close]');
    if (close) {
      event.preventDefault();
      closeModal();
      return;
    }
    const link = target.closest<HTMLAnchorElement>('a[href^="#post-"]');
    if (!link) return;
    event.preventDefault();
    openModal(decodeURIComponent(link.hash.slice('#post-'.length)));
  });

  window.addEventListener('keydown', (event) => {
    if (!openId) return;
    if (event.key === 'ArrowLeft') step(-1);
    if (event.key === 'ArrowRight') step(1);
    // Escape is handled here as well as natively: engines differ on whether
    // a modal dialog dismisses (and fires cancel/close) on its own.
    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
    }
  });

  // Deep links (/looks#post-xyz), including back/forward navigation.
  const syncToHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id.startsWith('post-') && modals.has(id.slice(5))) {
      openModal(id.slice(5), false);
    } else if (openId) {
      // Back button: close without pushing another history entry.
      const current = openId;
      modals.get(current)?.close();
      openId = null;
      document.documentElement.classList.remove('modal-open');
    }
  };
  window.addEventListener('popstate', syncToHash);
  syncToHash();

  /* ----------------------------------------- optional WebGL gallery view */
  // The grid is the default and the fallback. three.js is fetched only when
  // the visitor actually switches to Gallery, so the page cost is unchanged
  // for everyone else.
  const railData = document.getElementById('rail-data');
  const viewSwitch = document.querySelector<HTMLElement>('[data-view-switch]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const gridSection = document.querySelector<HTMLElement>('.feed-grid');
  const gridExtras = document.querySelector<HTMLElement>('.lookbook-more');

  const webglSupported = () => {
    try {
      const probe = document.createElement('canvas');
      return Boolean(
        probe.getContext('webgl2') ||
          probe.getContext('webgl') ||
          probe.getContext('experimental-webgl'),
      );
    } catch {
      return false;
    }
  };

  if (railData && viewSwitch && rail && webglSupported()) {
    viewSwitch.hidden = false;
    const looksForRail = JSON.parse(railData.textContent || '[]');
    const canvas = rail.querySelector<HTMLCanvasElement>('[data-rail-canvas]')!;
    const loading = rail.querySelector<HTMLElement>('[data-rail-loading]')!;
    const positionEl = rail.querySelector<HTMLElement>('[data-rail-position]')!;
    const titleEl = rail.querySelector<HTMLElement>('[data-rail-title]')!;
    const statusEl = rail.querySelector<HTMLElement>('[data-rail-status]')!;
    const openButton = rail.querySelector<HTMLButtonElement>('[data-rail-open]')!;

    let gallery: import('../../scripts/look-gallery').GalleryHandle | null = null;
    let activeRailIndex = 0;
    let loadingGallery = false;

    /* ------------------------------------ immersive mode + detail sheet */
    const sheet = rail.querySelector<HTMLElement>('[data-rail-sheet]')!;
    const sheetToggle = rail.querySelector<HTMLButtonElement>('[data-rail-sheet-toggle]')!;
    const sheetHint = rail.querySelector<HTMLElement>('[data-rail-sheet-hint]')!;
    const expandButton = rail.querySelector<HTMLButtonElement>('[data-rail-expand]')!;
    const expandLabel = rail.querySelector<HTMLElement>('[data-rail-expand-label]')!;

    const setSheet = (open: boolean) => {
      sheet.classList.toggle('is-open', open);
      rail.classList.toggle('sheet-open', open);
      sheetToggle.setAttribute('aria-expanded', String(open));
      sheetHint.textContent = open ? 'Close the details' : 'Swipe up for the details';
    };

    const setImmersive = (on: boolean) => {
      rail.classList.toggle('is-immersive', on);
      document.documentElement.classList.toggle('rail-immersive', on);
      expandButton.setAttribute('aria-pressed', String(on));
      expandButton.setAttribute('aria-label', on ? 'Exit full screen' : 'Fill the screen');
      expandLabel.textContent = on ? 'Exit' : 'Fill the screen';
      if (!on) setSheet(false);
      // The canvas just changed size in both directions.
      requestAnimationFrame(() => gallery?.resize());
    };

    /**
     * The sheet reads its content from the post's dialog, which already
     * holds the caption, elements, and links: one source, no duplication.
     */
    const fillSheet = (lookId: string) => {
      const source = document.querySelector<HTMLElement>(`[data-post-modal="${lookId}"]`);
      if (!source) return;
      const text = (selector: string) =>
        source.querySelector<HTMLElement>(selector)?.textContent?.trim() ?? '';

      const title = text('.post-modal-caption summary');
      const caption = text('.post-modal-caption p');
      rail.querySelector<HTMLElement>('[data-sheet-meta]')!.textContent = text('.post-modal-meta');
      rail.querySelector<HTMLElement>('[data-sheet-title]')!.textContent = title;
      // The caption opens with the same line the title uses; showing both
      // reads as a duplication bug rather than a heading.
      const withoutTitle = caption.startsWith(title.replace(/…$/, ''))
        ? caption.slice(caption.indexOf('\n') + 1).trimStart()
        : caption;
      rail.querySelector<HTMLElement>('[data-sheet-caption]')!.textContent = withoutTitle;

      const elements = rail.querySelector<HTMLElement>('[data-sheet-elements]')!;
      elements.replaceChildren(
        ...Array.from(source.querySelectorAll('.post-modal-elements li')).map((item) => {
          const li = document.createElement('li');
          li.textContent = item.textContent;
          return li;
        }),
      );

      const shopSource = source.querySelector<HTMLAnchorElement>('.post-modal-shop');
      const shop = rail.querySelector<HTMLAnchorElement>('[data-sheet-shop]')!;
      shop.hidden = !shopSource;
      if (shopSource) shop.href = shopSource.getAttribute('href')!;

      const igSource = source.querySelector<HTMLAnchorElement>('.post-modal-source');
      const ig = rail.querySelector<HTMLAnchorElement>('[data-sheet-ig]')!;
      if (igSource) ig.href = igSource.href;
    };

    const describe = (look: { id: string; title: string; category: string; shoppable: boolean }, index: number) => {
      activeRailIndex = index;
      positionEl.textContent = `${index + 1} of ${looksForRail.length} · ${look.category}`;
      titleEl.textContent = look.title;
      openButton.textContent = look.shoppable ? 'Open and shop this look' : 'Open this look';
      statusEl.textContent = `${look.title}, ${index + 1} of ${looksForRail.length}`;
      fillSheet(look.id);
    };

    expandButton.addEventListener('click', () => {
      setImmersive(!rail.classList.contains('is-immersive'));
    });

    sheetToggle.addEventListener('click', () => {
      setSheet(!sheet.classList.contains('is-open'));
    });

    // Drag the sheet itself: up opens, down closes.
    let sheetStartY = 0;
    let sheetTracking = false;
    sheet.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length !== 1) return;
        sheetStartY = event.touches[0].clientY;
        sheetTracking = true;
      },
      { passive: true },
    );
    sheet.addEventListener(
      'touchend',
      (event) => {
        if (!sheetTracking) return;
        sheetTracking = false;
        const dy = event.changedTouches[0].clientY - sheetStartY;
        const body = rail.querySelector<HTMLElement>('[data-rail-sheet-body]');
        if (dy < -50) setSheet(true);
        // Only collapse on a downward drag that did not start mid-scroll.
        else if (dy > 50 && (body?.scrollTop ?? 0) <= 0) setSheet(false);
      },
      { passive: true },
    );

    // Category filters apply to the grid only; the rail always carries the
    // whole lookbook, so the chips step aside rather than implying they act.
    const filterBar = document.querySelector<HTMLElement>('[data-instagram-filter-bar]');

    const showGrid = () => {
      rail.hidden = true;
      if (gridSection) gridSection.hidden = false;
      if (gridExtras) gridExtras.hidden = false;
      if (filterBar) filterBar.hidden = false;
      gallery?.setPaused(true);
      for (const button of viewSwitch.querySelectorAll('button')) {
        button.setAttribute('aria-pressed', String(button.dataset.view === 'grid'));
      }
    };

    const showGallery = async () => {
      if (gridSection) gridSection.hidden = true;
      if (gridExtras) gridExtras.hidden = true;
      if (filterBar) filterBar.hidden = true;
      rail.hidden = false;
      for (const button of viewSwitch.querySelectorAll('button')) {
        button.setAttribute('aria-pressed', String(button.dataset.view === 'gallery'));
      }

      if (gallery) {
        gallery.setPaused(false);
        gallery.resize();
        return;
      }
      if (loadingGallery) return;
      loadingGallery = true;

      try {
        const { createLookGallery } = await import('../../scripts/look-gallery');
        gallery = createLookGallery({
          canvas,
          looks: looksForRail,
          onActiveChange: describe,
          onSelect: (look) => openModal(look.id),
          // Swiping up on the stage is the headline gesture of immersive
          // mode; outside it, an up-swipe expands into immersive first.
          onVerticalSwipe: (direction) => {
            if (direction === 'up') {
              if (!rail.classList.contains('is-immersive')) setImmersive(true);
              else setSheet(true);
            } else if (sheet.classList.contains('is-open')) {
              setSheet(false);
            }
          },
          // Hold the reveal until there are actual looks on the rail: an
          // empty stage of placeholders reads as broken.
          onReady: () => {
            loading.hidden = true;
            canvas.classList.add('is-ready');
          },
        });
        // Safety net if the network stalls: show the rail anyway.
        window.setTimeout(() => {
          loading.hidden = true;
          canvas.classList.add('is-ready');
        }, 4000);
      } catch {
        // WebGL or the chunk failed: fall back to the grid for good.
        loading.textContent = 'Gallery view is unavailable on this device.';
        viewSwitch.hidden = true;
        showGrid();
      } finally {
        loadingGallery = false;
      }
    };

    for (const button of viewSwitch.querySelectorAll<HTMLButtonElement>('button')) {
      button.addEventListener('click', () => {
        if (button.dataset.view === 'gallery') void showGallery();
        else showGrid();
      });
    }

    rail.querySelector('[data-rail-prev]')?.addEventListener('click', () => gallery?.step(-1));
    rail.querySelector('[data-rail-next]')?.addEventListener('click', () => gallery?.step(1));
    openButton.addEventListener('click', () => {
      const look = looksForRail[activeRailIndex];
      if (look) openModal(look.id);
    });

    // Arrow keys drive the rail whenever it has focus and no modal is open.
    // Escape steps back out: sheet first, then full screen.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || openId) return;
      if (sheet.classList.contains('is-open')) setSheet(false);
      else if (rail.classList.contains('is-immersive')) setImmersive(false);
    });

    rail.addEventListener('keydown', (event) => {
      if (openId) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        gallery?.step(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        gallery?.step(1);
      }
      if (event.key === 'Enter' && event.target === canvas) {
        const look = looksForRail[activeRailIndex];
        if (look) openModal(look.id);
      }
    });

    window.addEventListener('resize', () => gallery?.resize());
    // Stop rendering whenever the rail is not the thing being looked at.
    document.addEventListener('visibilitychange', () => {
      gallery?.setPaused(document.hidden || rail.hidden);
    });
  }
</script>

