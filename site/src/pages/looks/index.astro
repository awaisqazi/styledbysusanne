---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Sparkle from '../../components/Sparkle.astro';
import {
  elementLabel,
  instagramPosts,
  resolveInstagramImage,
  similarToPost,
} from '../../lib/instagram';
import { LOOK_CATEGORIES, type LookCategory } from '../../lib/looks';

/**
 * Social-feed lookbook: an Instagram-style tile grid where every tile opens
 * an in-page modal (media carousel + caption + elements + recommendations),
 * navigable post to post like the feed it comes from. Progressive
 * enhancement throughout: without JavaScript the tiles anchor-jump to the
 * same detail blocks rendered at the end of the page (dialog:target), the
 * carousels swipe natively, and every post stays reachable.
 */
const gridCategories = (Object.keys(LOOK_CATEGORIES) as LookCategory[]).filter((category) =>
  instagramPosts.some((post) => post.category === category),
);
const categoryCounts = Object.fromEntries(
  gridCategories.map((category) => [
    category,
    instagramPosts.filter((post) => post.category === category).length,
  ]),
) as Record<LookCategory, number>;
const mediaCount = instagramPosts.reduce((total, post) => total + post.media.length, 0);

/** Element-tag recommendations shown inside each modal. */
const recommendationsById = new Map(
  instagramPosts.map((post) => [post.id, similarToPost(post, 3)]),
);

const dateLabel = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title="Shop the Looks"
  description="Browse Susanne's real outfits like a feed: tap any look for the full caption, every carousel slide, detected style elements, and shoppable piece-by-piece edits."
>
  <!-- ============================================================ Hero -->
  <section class="looks-hero bg-blush-wash">
    <Sparkle size={22} top="12%" right="7%" delay={0.5} />
    <Sparkle size={14} top="34%" right="14%" gold delay={1.7} />
    <div class="container">
      <p class="eyebrow">Shop the looks</p>
      <h1>Real outfits, from my closet to <em class="serif-italic">yours</em></h1>
      <p class="lede">
        Every look starts on @styled.by.susanne: a real day, a real outfit,
        and the styling note that made it work. Tap any look for the full
        story, every carousel slide, and similar outfits matched by what's
        actually in the photo.
      </p>
      <p class="looks-disclosure">
        Honesty first: some of the product links on these pages are affiliate
        links, which means I may earn a small commission if you shop through
        them, at no extra cost to you. <a
          href="/policies/affiliate-disclosure">Here's exactly how that works</a>.
      </p>
    </div>
  </section>

  <!-- =============================================== Instagram lookbook -->
  <section class="section instagram-lookbook" id="instagram-lookbook">
    <div class="lookbook-toolbar" data-lookbook-toolbar>
      <div class="container">
        <div class="lookbook-toolbar-row">
          <div
            class="filter-chips"
            role="group"
            aria-label="Filter looks by category"
            data-instagram-filter-bar
            hidden
          >
            <button class="filter-chip" type="button" data-instagram-filter="all" aria-pressed="true">
              All looks <span class="filter-chip-count">{instagramPosts.length}</span>
            </button>
            {
              gridCategories.map((category) => (
                <button
                  class="filter-chip"
                  type="button"
                  data-instagram-filter={category}
                  aria-pressed="false"
                >
                  {LOOK_CATEGORIES[category]}
                  <span class="filter-chip-count">{categoryCounts[category]}</span>
                </button>
              ))
            }
          </div>
          <p class="lookbook-count">
            <strong>{instagramPosts.length}</strong> posts ·
            <strong>{mediaCount}</strong> visuals
          </p>
        </div>
      </div>
    </div>

    <div class="container">
      <p class="visually-hidden" role="status" data-instagram-filter-status></p>

      <ul class="feed-grid" role="list">
        {
          instagramPosts.map((post, index) => (
            <li data-instagram-category={post.category} data-tile={post.id}>
              <a
                class="feed-tile"
                href={`#post-${post.id}`}
                aria-label={`Open look: ${post.title}`}
              >
                <Image
                  src={resolveInstagramImage(post.media[0].src)}
                  alt={post.media[0].alt}
                  widths={[320, 480, 700]}
                  sizes="(max-width: 980px) 33vw, 310px"
                  loading={index < 6 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                <span class="feed-tile-badges" aria-hidden="true">
                  {post.media.length > 1 && (
                    <svg class="feed-tile-stack" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 3h11a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-1V6a2 2 0 0 0-2-2H8V4a1 1 0 0 1 1-1Z" />
                      <rect x="3" y="7" width="14" height="14" rx="1.5" />
                    </svg>
                  )}
                  {post.kind === 'reel' && <span class="feed-tile-tag">Reel</span>}
                </span>
                {post.shopHref && <span class="feed-tile-shop" aria-hidden="true">Shop</span>}
                <span class="feed-tile-hover" aria-hidden="true">
                  <span>♥ {post.likes}</span>
                  <span>💬 {post.comments}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="lookbook-more">
        <div data-feed-sentinel aria-hidden="true"></div>
        <button class="btn btn--outline" type="button" data-show-more hidden>
          Show more looks
        </button>
      </div>
    </div>
  </section>

  <!-- ============================================= From my closet to yours -->
  <section class="section section--ivory looks-outro">
    <div class="container container--narrow text-center">
      <p class="eyebrow eyebrow--center">Beyond the links</p>
      <h2>Want this taste applied to <em class="serif-italic">your</em> closet?</h2>
      <p class="lede looks-outro-lede">
        Shopping my looks is the free sample. The real magic is opening your
        own closet and finding outfits like these already built; that's what
        my styling services are for. And if you'd like pieces like these
        sourced for your life (not mine) all year round, that's literally the
        Digital Stylist's job.
      </p>
      <div class="looks-outro-actions">
        <a class="btn btn--primary" href="/services">Explore Styling Services</a>
        <a class="btn btn--outline" href="/services/ongoing-styling">Meet the Digital Stylist</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Let's find out what your version of these looks like"
    secondaryLabel="Browse Styling Services"
    secondaryHref="/services"
  />

  <!-- ================================================== Post modals -->
  {
    instagramPosts.map((post) => (
      <dialog
        class="post-modal"
        id={`post-${post.id}`}
        data-post-modal={post.id}
        aria-label={`Look from ${dateLabel(post.date)}: ${post.title}`}
      >
        <a class="post-modal-close" href="#instagram-lookbook" data-modal-close aria-label="Close look">
          ✕
        </a>

        <article class="post-modal-body">
          <div class="post-modal-media" data-instagram-gallery>
            <div
              class="post-modal-track"
              data-gallery-track
              tabindex={post.media.length > 1 ? 0 : undefined}
              role={post.media.length > 1 ? 'group' : undefined}
              aria-label={post.media.length > 1 ? `${post.media.length} photos` : undefined}
            >
              {post.media.map((media) => (
                <figure class="post-modal-slide">
                  <Image
                    src={resolveInstagramImage(media.src)}
                    alt={media.alt}
                    widths={[480, 720, 1080]}
                    sizes="(max-width: 900px) 100vw, 54vw"
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
            {post.media.length > 1 && (
              <>
                <button class="gallery-nav gallery-nav--prev" type="button" data-gallery-previous aria-label="Previous photo" disabled>
                  ←
                </button>
                <button class="gallery-nav gallery-nav--next" type="button" data-gallery-next aria-label="Next photo">
                  →
                </button>
                <div class="gallery-dots" data-gallery-dots aria-hidden="true">
                  {post.media.map((_, index) => (
                    <span class:list={['gallery-dot', { 'is-active': index === 0 }]} />
                  ))}
                </div>
                <span class="gallery-count" data-gallery-count>
                  1 / {post.media.length}
                </span>
              </>
            )}
          </div>

          <div class="post-modal-panel">
            <header class="post-modal-head">
              <p class="post-modal-kicker">
                {LOOK_CATEGORIES[post.category]}
                {post.kind === 'reel' && <span class="post-modal-reel">Reel</span>}
              </p>
              <p class="post-modal-meta">
                <time datetime={post.date}>{dateLabel(post.date)}</time>
                {post.location && <span> · {post.location}</span>}
              </p>
              {/* Fixed beside the dialog on desktop, in-flow on mobile. */}
              <div class="post-modal-steps">
                <button
                  class="post-modal-nav post-modal-nav--prev"
                  type="button"
                  data-modal-prev
                  aria-label="Previous look"
                >
                  ←
                </button>
                <button
                  class="post-modal-nav post-modal-nav--next"
                  type="button"
                  data-modal-next
                  aria-label="Next look"
                >
                  →
                </button>
              </div>
            </header>

            <p class="post-modal-stats">
              <span>♥ {post.likes} likes</span>
              <span>💬 {post.comments} comments</span>
            </p>

            <details class="post-modal-caption">
              <summary>{post.title}</summary>
              <p>{post.caption}</p>
            </details>

            {post.elements.length > 0 && (
              <ul class="post-modal-elements" role="list" aria-label="In this look">
                {post.elements.slice(0, 10).map((tag) => (
                  <li>{elementLabel(tag)}</li>
                ))}
              </ul>
            )}

            <div class="post-modal-actions">
              {post.shopHref && (
                <a class="btn btn--rose post-modal-shop" href={post.shopHref}>
                  Shop this look piece by piece
                </a>
              )}
              <a
                class="post-modal-source"
                href={post.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on Instagram <span aria-hidden="true">↗</span>
              </a>
            </div>

            {(recommendationsById.get(post.id) ?? []).length > 0 && (
              <div class="post-modal-related">
                <p class="post-modal-related-title">More like this</p>
                <ul role="list">
                  {(recommendationsById.get(post.id) ?? []).map(({ post: related, shared }) => (
                    <li>
                      <a href={`#post-${related.id}`} class="post-modal-related-card">
                        <span class="post-modal-related-thumb">
                          <Image
                            src={resolveInstagramImage(related.media[0].src)}
                            alt={related.media[0].alt}
                            widths={[120, 240]}
                            sizes="72px"
                            loading="lazy"
                          />
                        </span>
                        <span class="post-modal-related-text">
                          <span class="post-modal-related-label">
                            {shared.slice(0, 3).map(elementLabel).join(' · ')}
                          </span>
                          <span class="post-modal-related-name">{related.title}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      </dialog>
    ))
  }
</Base>

<script>
  // Progressive enhancement: without JavaScript every tile anchor-jumps to
  // its detail block (dialog:target renders it in-flow), carousels swipe
  // via scroll-snap, and the grid shows every post.

  /* ------------------------------- category filter + feed batching */
  const BATCH = 15;
  const bar = document.querySelector<HTMLElement>('[data-instagram-filter-bar]');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('li[data-tile]'));
  const status = document.querySelector<HTMLElement>('[data-instagram-filter-status]');
  const moreButton = document.querySelector<HTMLButtonElement>('[data-show-more]');
  const sentinel = document.querySelector<HTMLElement>('[data-feed-sentinel]');

  let activeFilter = 'all';
  let visibleCap = BATCH;

  const matching = () =>
    items.filter(
      (item) => activeFilter === 'all' || item.dataset.instagramCategory === activeFilter,
    );

  const apply = () => {
    const matches = matching();
    for (const item of items) item.hidden = true;
    matches.forEach((item, index) => {
      item.hidden = index >= visibleCap;
    });

    const shown = Math.min(visibleCap, matches.length);
    const remaining = matches.length - shown;
    if (status) status.textContent = `Showing ${shown} of ${matches.length} looks`;
    if (moreButton) {
      moreButton.hidden = remaining <= 0;
      moreButton.textContent = `Show ${Math.min(BATCH, remaining)} more looks (${remaining} left)`;
    }
  };

  if (bar && items.length) {
    bar.hidden = false;
    const chips = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('button[data-instagram-filter]'),
    );
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeFilter = chip.dataset.instagramFilter ?? 'all';
        visibleCap = BATCH;
        for (const candidate of chips) {
          candidate.setAttribute('aria-pressed', String(candidate === chip));
        }
        apply();
      });
    }

    moreButton?.addEventListener('click', () => {
      visibleCap += BATCH;
      apply();
    });

    // Social-feed scrolling: quietly load the next batch as the visitor
    // approaches the end; the button stays as an accessible fallback.
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting) && !moreButton?.hidden) {
            visibleCap += BATCH;
            apply();
          }
        },
        { rootMargin: '600px 0px' },
      ).observe(sentinel);
    }

    apply();
  }

  /* --------------------------------------- swipeable media carousels */
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-instagram-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    if (!track || track.children.length < 2) continue;

    const slideCount = track.children.length;
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    const dots = Array.from(gallery.querySelector<HTMLElement>('[data-gallery-dots]')?.children ?? []);

    let active = 0;
    const render = () => {
      if (previous) previous.disabled = active === 0;
      if (next) next.disabled = active === slideCount - 1;
      if (count) count.textContent = `${active + 1} / ${slideCount}`;
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active));
    };

    const goTo = (index: number) => {
      const clamped = Math.min(slideCount - 1, Math.max(0, index));
      // Update immediately rather than waiting on the debounced scroll
      // listener: smooth scrolling can be interrupted, and the controls
      // should never lag behind the tap.
      active = clamped;
      render();
      track.scrollTo({ left: clamped * track.clientWidth, behavior: 'smooth' });
    };

    previous?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));

    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          const index = Math.round(track.scrollLeft / track.clientWidth);
          if (index !== active) {
            active = Math.min(slideCount - 1, Math.max(0, index));
            render();
          }
        }, 80);
      },
      { passive: true },
    );

    render();
  }

  /* -------------------------------------------------- post modals */
  const modals = new Map(
    Array.from(document.querySelectorAll<HTMLDialogElement>('[data-post-modal]')).map(
      (modal) => [modal.dataset.postModal!, modal],
    ),
  );
  let openId: string | null = null;

  const orderedIds = () => matching().map((item) => item.dataset.tile!);

  const revealTile = (id: string) => {
    const tile = document.querySelector<HTMLLIElement>(`li[data-tile="${id}"]`);
    if (!tile) return;
    const matches = matching();
    const index = matches.indexOf(tile);
    if (index >= 0 && index >= visibleCap) {
      visibleCap = index + 1;
      apply();
    }
  };

  const setHash = (hash: string) => {
    // pushState instead of location.hash: no native scroll jump.
    history.pushState(null, '', hash || location.pathname);
  };

  /**
   * Teardown for whichever post is showing. Idempotent and keyed by id, so
   * a late `close` event from a modal we already navigated away from is a
   * no-op. Not driven by the `close` event alone: some engines do not fire
   * it for programmatic close(), which would strand the scroll lock.
   */
  const cleanupAfterClose = (id: string, restoreScroll = true) => {
    if (openId !== id) return;
    openId = null;
    document.documentElement.classList.remove('modal-open');
    setHash('');
    if (!restoreScroll) return;
    const tile = document.querySelector(`li[data-tile="${id}"] a`);
    const rect = tile?.getBoundingClientRect();
    if (tile && rect && (rect.bottom < 0 || rect.top > window.innerHeight)) {
      tile.scrollIntoView({ block: 'center' });
    }
  };

  const closeModal = () => {
    if (!openId) return;
    const id = openId;
    modals.get(id)?.close();
    cleanupAfterClose(id);
  };

  const openModal = (id: string, updateHash = true) => {
    const modal = modals.get(id);
    if (!modal) return;
    if (openId && openId !== id) modals.get(openId)?.close();
    openId = id;
    if (!modal.open) modal.showModal();
    document.documentElement.classList.add('modal-open');
    revealTile(id);
    if (updateHash) setHash(`#post-${id}`);

    const ids = orderedIds();
    const index = ids.indexOf(id);
    const prev = modal.querySelector<HTMLButtonElement>('[data-modal-prev]');
    const next = modal.querySelector<HTMLButtonElement>('[data-modal-next]');
    if (prev) prev.disabled = index <= 0;
    if (next) next.disabled = index === -1 || index >= ids.length - 1;
  };

  const step = (direction: number) => {
    if (!openId) return;
    const ids = orderedIds();
    const target = ids[ids.indexOf(openId) + direction];
    if (target) openModal(target);
  };

  for (const [id, modal] of modals) {
    // Escape and any other native dismissal land here.
    modal.addEventListener('close', () => cleanupAfterClose(id));
    modal.addEventListener('cancel', () => cleanupAfterClose(id));

    // Click on the backdrop (the dialog element itself) closes.
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });

    modal.querySelector('[data-modal-prev]')?.addEventListener('click', () => step(-1));
    modal.querySelector('[data-modal-next]')?.addEventListener('click', () => step(1));
  }

  // One delegated handler covers tiles, recommendation cards, and close
  // links, wherever they live.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const close = target.closest('[data-modal-close]');
    if (close) {
      event.preventDefault();
      closeModal();
      return;
    }
    const link = target.closest<HTMLAnchorElement>('a[href^="#post-"]');
    if (!link) return;
    event.preventDefault();
    openModal(decodeURIComponent(link.hash.slice('#post-'.length)));
  });

  window.addEventListener('keydown', (event) => {
    if (!openId) return;
    if (event.key === 'ArrowLeft') step(-1);
    if (event.key === 'ArrowRight') step(1);
    // Escape is handled here as well as natively: engines differ on whether
    // a modal dialog dismisses (and fires cancel/close) on its own.
    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
    }
  });

  // Deep links (/looks#post-xyz), including back/forward navigation.
  const syncToHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id.startsWith('post-') && modals.has(id.slice(5))) {
      openModal(id.slice(5), false);
    } else if (openId) {
      // Back button: close without pushing another history entry.
      const current = openId;
      modals.get(current)?.close();
      openId = null;
      document.documentElement.classList.remove('modal-open');
    }
  };
  window.addEventListener('popstate', syncToHash);
  syncToHash();
</script>

<style>
  /* Hero */
  .looks-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2.5rem + 3.5vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .looks-hero h1 {
    margin-bottom: 0.45em;
  }

  .looks-hero h1 em {
    color: var(--rose);
  }

  .looks-hero .lede {
    max-width: 44em;
  }

  .looks-disclosure {
    font-size: 0.85rem;
    color: var(--umber);
    max-width: 52em;
    margin: 1.4rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--gold-hairline);
  }

  /* Sticky filter toolbar */
  .instagram-lookbook {
    border-top: 1px solid var(--line-soft);
    padding-top: 0;
  }

  .lookbook-toolbar {
    position: sticky;
    top: 4.35rem;
    z-index: 30;
    background: rgba(250, 246, 239, 0.93);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block: 1px solid var(--line-soft);
    padding-block: 0.75rem;
    margin-bottom: clamp(0.35rem, 1vw, 1.6rem);
  }

  .lookbook-toolbar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .lookbook-count {
    flex: 0 0 auto;
    color: var(--umber);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0;
    padding-left: 1.1rem;
    border-left: 1px solid var(--gold-hairline);
  }

  .lookbook-count strong {
    color: var(--espresso);
  }

  .filter-chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.15rem;
    min-width: 0;
    /* Fade the trailing edge so a chip cut off mid-scroll reads as "more
       this way" rather than as a clipped layout. */
    mask-image: linear-gradient(to right, #000 calc(100% - 1.75rem), transparent);
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 1.75rem), transparent);
  }

  .filter-chips::-webkit-scrollbar {
    display: none;
  }

  .filter-chips[hidden] {
    display: none;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-height: 2.75rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 550;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--rose);
    background: transparent;
    border: 1px solid var(--rose);
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition),
      border-color var(--transition), box-shadow var(--transition);
  }

  .filter-chip-count {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--rose-deep);
    background: var(--rose-soft);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
    transition: background-color var(--transition), color var(--transition);
  }

  .filter-chip:hover {
    color: var(--rose-deep);
    border-color: var(--rose-deep);
    background: var(--rose-tint);
