    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: var(--umber);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
  }

  .rail-loading[hidden] {
    display: none;
  }

  .rail-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--espresso);
    background: rgba(250, 246, 239, 0.9);
    border: 1px solid var(--line);
    border-radius: 50%;
    font: inherit;
    font-size: 1.05rem;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(54, 44, 36, 0.16);
  }

  .rail-arrow--prev {
    left: 0.8rem;
  }

  .rail-arrow--next {
    right: 0.8rem;
  }

  .rail-arrow:hover {
    color: var(--rose-deep);
    border-color: var(--rose);
  }

  /* Fill-the-screen toggle */
  .rail-expand {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 2;
    min-height: 2.2rem;
    padding: 0.45rem 0.95rem;
    color: var(--espresso);
    background: rgba(250, 246, 239, 0.9);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .rail-expand:hover {
    color: var(--rose-deep);
    border-color: var(--rose);
  }

  /* Immersive: the rail takes the whole viewport. */
  .rail.is-immersive {
    position: fixed;
    inset: 0;
    z-index: 60;
    margin: 0;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(120% 80% at 50% 40%, var(--rose-soft) 0%, transparent 62%),
      linear-gradient(180deg, var(--paper) 0%, var(--ivory) 100%);
  }

  .rail.is-immersive .rail-stage {
    flex: 1;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .rail.is-immersive .rail-canvas {
    height: 100%;
    touch-action: none;
  }

  .rail.is-immersive .rail-caption {
    display: none;
  }

  .rail.is-immersive .rail-sheet {
    display: flex;
  }

  :global(html.rail-immersive) {
    overflow: hidden;
  }

  /* Nothing of the page shows through a full-screen rail. */
  :global(html.rail-immersive .site-header),
  :global(html.rail-immersive .announcement) {
    display: none;
  }

  /* With the sheet up, lift the looks into what is left of the screen so
     the centred one stays in view instead of hiding behind the panel. */
  .rail.is-immersive.sheet-open .rail-canvas {
    transform: translateY(-19%) scale(0.84);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rail.is-immersive .rail-canvas {
      transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  /* Detail sheet: a tab at rest, the full story when opened. */
  .rail-sheet {
    display: none;
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    flex-direction: column;
    max-height: min(58dvh, 34rem);
    background: var(--paper);
    border-top: 1px solid var(--gold-hairline);
    border-radius: var(--radius) var(--radius) 0 0;
    box-shadow: 0 -8px 32px rgba(54, 44, 36, 0.18);
    transform: translateY(calc(100% - 4.1rem));
    padding-bottom: env(safe-area-inset-bottom);
  }

  .rail-sheet.is-open {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rail-sheet {
      transition: transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  .rail-sheet-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem 0.85rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .rail-sheet-grip {
    width: 2.6rem;
    height: 0.28rem;
    border-radius: 999px;
    background: var(--blush);
  }

  .rail-sheet-hint {
    color: var(--rose);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rail-sheet-body {
    overflow-y: auto;
    padding: 0 clamp(1.1rem, 4vw, 2rem) 1.6rem;
    text-align: left;
  }

  .rail-sheet-meta {
    color: var(--umber);
    font-size: 0.78rem;
    margin: 0 0 0.35rem;
  }

  .rail-sheet-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0 0 0.7rem;
  }

  .rail-sheet-caption {
    white-space: pre-line;
    color: var(--umber);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .rail-sheet-elements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
  }

  .rail-sheet-elements li {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--espresso);
    background: var(--ivory);
    border: 1px solid var(--gold-hairline);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
  }

  .rail-sheet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
  }

  .rail-sheet-shop[hidden] {
    display: none;
  }

  .rail-sheet-ig {
    color: var(--umber);
    font-size: 0.78rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
  }

  .rail-caption {
    text-align: center;
    padding: 1.4rem 1rem 0;
  }

  .rail-position {
    color: var(--rose);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .rail-title {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.7rem);
    line-height: 1.3;
    max-width: 32em;
    margin: 0 auto 1.1rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .rail-hint {
    color: var(--umber);
    font-size: 0.8rem;
    margin: 1rem 0 0;
  }

  @media (max-width: 640px) {
    .rail-canvas {
      height: clamp(20rem, 46vh, 26rem);
    }

    .rail-arrow {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .lookbook-more {
    display: flex;
    justify-content: center;
    margin-top: 2.2rem;
  }

  .lookbook-more[hidden] {
    display: none;
  }

  .lookbook-more .btn[hidden] {
    display: none;
  }

  /* Outro band */
  .looks-outro h2 em {
    color: var(--rose);
  }

  .looks-outro-lede {
    margin-inline: auto;
    margin-bottom: 2.2rem;
  }

  .looks-outro-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  /* ------------------------------------------------------ post modal */
  .post-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(64rem, calc(100vw - 2rem));
    width: 100%;
    max-height: calc(100dvh - 2rem);
  }

  .post-modal::backdrop {
    background: rgba(35, 26, 20, 0.72);
    backdrop-filter: blur(6px);
  }

  .post-modal-body {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    background: var(--paper, #faf6ef);
    border-radius: var(--radius);
    overflow: hidden;
    max-height: calc(100dvh - 2rem);
  }

  /* Motion: entrance, post-to-post direction, and the spring back from a
     half-finished drag. Every rule here is inside the no-preference query,
     so reduced-motion visitors get the same interactions with no movement. */
  @media (prefers-reduced-motion: no-preference) {
    .post-modal-body {
      transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 240ms ease;
      will-change: transform;
    }

    .post-modal-body[data-enter='open'] {
      animation: modal-open 280ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .post-modal-body[data-enter='right'] {
      animation: modal-from-right 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .post-modal-body[data-enter='left'] {
      animation: modal-from-left 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .feed-tile {
      transition: scale 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .feed-tile:active {
      scale: 0.97;
    }
  }

  @keyframes modal-open {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes modal-from-right {
    from {
      opacity: 0;
      transform: translateX(6%);
    }
  }

  @keyframes modal-from-left {
    from {
      opacity: 0;
      transform: translateX(-6%);
    }
  }

  @keyframes sheet-up {
    from {
      opacity: 0.4;
      transform: translateY(6%);
    }
  }

  .post-modal-media {
    position: relative;
    background: var(--ivory);
  }

  .post-modal-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .post-modal-track::-webkit-scrollbar {
    display: none;
  }

  .post-modal-track:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: -2px;
  }

  .post-modal-slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .post-modal-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Carousel controls (shared look with the old cards) */
  .gallery-nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.4rem;
    height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--espresso);
    background: rgba(250, 246, 239, 0.92);
    border: 1px solid var(--line);
    border-radius: 50%;
    font: inherit;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(54, 44, 36, 0.18);
  }

  .gallery-nav--prev {
    left: 0.7rem;
  }

  .gallery-nav--next {
    right: 0.7rem;
  }

  .gallery-nav:disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .gallery-dots {
    position: absolute;
    inset-inline: 0;
    bottom: 0.7rem;
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    pointer-events: none;
  }

  .gallery-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgba(250, 246, 239, 0.65);
    box-shadow: 0 1px 4px rgba(54, 44, 36, 0.35);
  }

  .gallery-dot.is-active {
    background: var(--card);
    scale: 1.25;
  }

  .gallery-count {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    color: var(--paper);
    background: rgba(54, 44, 36, 0.82);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  /* Panel */
  .post-modal-panel {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.2rem, 1rem + 1vw, 1.8rem);
    overflow-y: auto;
  }

  .post-modal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-right: 2.4rem; /* room for the close button */
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .post-modal-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--rose);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }

  .post-modal-reel {
    color: var(--rose-deep);
    background: var(--rose-soft);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    letter-spacing: 0.14em;
  }

  .post-modal-meta {
    color: var(--umber);
    font-size: 0.78rem;
    margin: 0;
  }

  .post-modal-caption summary {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--espresso);
    cursor: pointer;
    list-style: none;
  }

  .post-modal-caption summary::-webkit-details-marker {
    display: none;
  }

  .post-modal-caption summary::after {
    content: ' … more';
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--umber);
  }

  .post-modal-caption[open] summary::after {
    content: '';
  }

  .post-modal-caption p {
    white-space: pre-line;
    color: var(--umber);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0.7rem 0 0;
  }

  .post-modal-elements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-modal-elements li {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--espresso);
    background: var(--ivory);
    border: 1px solid var(--gold-hairline);
    border-radius: 999px;
    padding: 0.22rem 0.6rem;
  }

  .post-modal-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .post-modal-shop {
    width: 100%;
    text-align: center;
  }

  .post-modal-source {
    color: var(--umber);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
  }

  .post-modal-source:hover {
    color: var(--espresso);
    border-color: var(--gold);
  }

  /* Recommendations */
  .post-modal-related {
    border-top: 1px solid var(--line-soft);
    padding-top: 0.9rem;
    margin-top: auto;
  }

  .post-modal-related-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin: 0 0 0.7rem;
  }

  .post-modal-related ul {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-modal-related-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.35rem;
    transition: background-color var(--transition);
  }

  .post-modal-related-card:hover,
  .post-modal-related-card:focus-visible {
    background: var(--rose-tint, var(--ivory));
  }

  .post-modal-related-thumb {
    flex: 0 0 4.5rem;
    aspect-ratio: 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--ivory);
  }

  .post-modal-related-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-modal-related-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .post-modal-related-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.88rem;
    color: var(--rose-deep);
  }

  .post-modal-related-name {
    color: var(--umber);
    font-size: 0.78rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* Close + post navigation */
  .post-modal-close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    color: var(--espresso);
    background: rgba(250, 246, 239, 0.92);
    border: 1px solid var(--line);
    border-radius: 50%;
    text-decoration: none;
    font-size: 0.95rem;
    box-shadow: 0 2px 12px rgba(54, 44, 36, 0.18);
  }

  .post-modal-close:hover {
    color: var(--rose-deep);
    border-color: var(--rose);
  }

  /* Position counter and swipe hint are mobile-only affordances. */
  .post-modal-position,
  .swipe-hint {
    display: none;
  }

  /* Desktop: the pair sits outside the dialog card, fixed to the viewport,
     so their DOM home inside the header is irrelevant. */
  .post-modal-steps {
    display: contents;
  }

  .post-modal-nav {
    position: fixed;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--espresso);
    background: rgba(250, 246, 239, 0.95);
    border: 1px solid var(--line);
    border-radius: 50%;
    font: inherit;
    font-size: 1.05rem;
    cursor: pointer;
    box-shadow: 0 2px 14px rgba(54, 44, 36, 0.3);
  }

  .post-modal-nav--prev {
    left: max(0.8rem, calc((100vw - 64rem) / 2 - 3.6rem));
  }

  .post-modal-nav--next {
    right: max(0.8rem, calc((100vw - 64rem) / 2 - 3.6rem));
  }

  .post-modal-nav:disabled {
    opacity: 0.25;
    cursor: default;
    pointer-events: none;
  }

  /* Post navigation needs JS; hide it (and the hover overlay hint) without */
  :global(html:not(.js)) .post-modal-nav,
  :global(html:not(.js)) .gallery-nav,
  :global(html:not(.js)) .gallery-count {
    display: none;
  }

  /* No-JS fallback: a targeted dialog renders in-flow as a plain section.
     Position and sizing are stated explicitly so neither the UA's absolute
     positioning for dialogs nor the mobile 100dvh rule can clip it. */
  :global(html:not(.js)) .post-modal:target {
    display: block;
    position: relative;
    inset: auto;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: none;
    margin: 0;
  }

  :global(html:not(.js)) .post-modal:target .post-modal-body {
    height: auto;
    max-height: none;
    border-top: 1px solid var(--line);
    border-radius: 0;
  }

  :global(html:not(.js)) .post-modal:target .post-modal-panel {
    overflow: visible;
  }

  :global(html:not(.js)) .post-modal:target .post-modal-close {
    position: sticky;
    top: 5rem;
    float: right;
  }

  /* Lock the page behind an open modal */
  :global(html.modal-open) {
    overflow: hidden;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .post-modal {
      max-width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      margin: 0;
    }

    .post-modal-body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
    }

    /* Fixed height, not aspect-ratio: with a capped height the ratio would
       shrink the box's WIDTH and leave dead space beside the photo. */
    .post-modal-media {
      width: 100%;
      height: min(58dvh, 32rem);
    }

    .post-modal-slide,
    .post-modal-slide :global(img) {
      height: 100%;
    }

    /* Swipe is the native gesture here, and the dots already signal a
       carousel; two sets of arrows on one small screen just read as noise. */
    .gallery-nav {
      display: none;
    }

    /* A sheet rising from the bottom reads as "mobile" the way a scaling
       card does not. */
    @media (prefers-reduced-motion: no-preference) {
      .post-modal-body[data-enter='open'] {
        animation-name: sheet-up;
        animation-duration: 320ms;
      }
    }

    /* Grab handle: the affordance for drag-to-dismiss. */
    .post-modal-media::after {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 50%;
      translate: -50% 0;
      width: 2.6rem;
      height: 0.28rem;
      border-radius: 999px;
      background: rgba(250, 246, 239, 0.75);
      box-shadow: 0 1px 4px rgba(54, 44, 36, 0.3);
      pointer-events: none;
    }

    /* Mobile: the arrows sit on the photo edges, where they double as the
       signal that there are more looks either side. The panel below stays
       clear, so they can never cover the caption or the shop button. */
    .post-modal-steps {
      display: contents;
    }

    .post-modal-nav {
      position: fixed;
      top: min(29dvh, 16rem);
      translate: 0 -50%;
      width: 2.5rem;
      height: 2.5rem;
      font-size: 0.95rem;
      color: var(--espresso);
      background: rgba(250, 246, 239, 0.82);
      border-color: rgba(250, 246, 239, 0.5);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      box-shadow: 0 2px 10px rgba(54, 44, 36, 0.25);
    }

    .post-modal-nav--prev {
      left: 0.6rem;
    }

    .post-modal-nav--next {
      right: 0.6rem;
    }

    .post-modal-nav:disabled {
      opacity: 0;
    }

    /* Counter: the "there is a sequence here" cue. */
    .post-modal-position {
