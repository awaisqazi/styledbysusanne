---
import { NAV, ANNOUNCEMENT, SITE } from '../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<div class="announcement">
  <p>{ANNOUNCEMENT}</p>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/">
      Styled <span class="serif-italic wordmark-by">by</span> Susanne
    </a>

    {/* Label lives on the button, not in a child span: a child would take
        the :first-child slot the top bar needs to form the X. */}
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : isActive(item.href) ? 'true' : undefined}
              >
                <span class="nav-label">{item.label}</span>
                <span class="nav-chevron" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-foot">
        <a class="btn btn--rose nav-cta" href="/book">Book a Conversation</a>
        <p class="nav-note">Every engagement starts with a free 30-minute conversation.</p>
        <a class="nav-handle" href={SITE.instagram} rel="noopener">
          {SITE.instagramHandle}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .announcement {
    background: var(--espresso);
    color: var(--paper);
    text-align: center;
    padding: 0.45rem 1rem;
  }

  .announcement p {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 246, 239, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-by {
    font-weight: 400;
    color: var(--rose);
    margin-inline: 0.1em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.9rem;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav ul a {
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--umber);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .site-nav ul a:hover {
    color: var(--espresso);
    border-color: var(--gold-hairline);
  }

  .site-nav ul a[aria-current] {
    color: var(--espresso);
    border-color: var(--gold);
  }

  .nav-cta {
    padding: 0.65rem 1.3rem;
    font-size: 0.8rem;
  }

  /* Toggle: a rose-tinted pill that folds cleanly into an X. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 7px;
    width: 46px;
    height: 46px;
    padding: 12px;
    background: var(--rose-soft);
    border: 1px solid var(--blush);
    border-radius: 999px;
    cursor: pointer;
  }

  .nav-toggle:hover,
  .nav-toggle[aria-expanded='true'] {
    background: var(--rose);
    border-color: var(--rose);
  }

  .nav-toggle-bar {
    display: block;
    height: 1.5px;
    width: 100%;
    border-radius: 2px;
    background: var(--rose-deep);
    transition: transform var(--transition), background-color var(--transition);
  }

  .nav-toggle:hover .nav-toggle-bar,
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar {
    background: #fffdf9;
  }

  /* Each bar travels half the gap plus half the other bar's height so the
     two cross exactly at the centre. */
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* Chevrons and the panel footer are mobile-only furniture. */
  .nav-chevron,
  .nav-foot .nav-note,
  .nav-foot .nav-handle {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* Same blush wash the hero uses, so the panel reads as part of the
         brand rather than a dropped-in system menu. */
      background: linear-gradient(180deg, var(--rose-soft) 0%, var(--paper) 42%);
      border-top: 1px solid var(--gold-hairline);
      border-bottom: 1px solid var(--line);
      border-radius: 0 0 var(--radius) var(--radius);
      box-shadow: var(--shadow-lift);
      padding: 0.6rem 1.25rem 1.5rem;
      max-height: calc(100dvh - 100%);
      overflow-y: auto;
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav ul li + li {
      border-top: 1px solid var(--gold-hairline);
    }

    /* Editorial serif at a comfortable tap size, not shouting sans caps. */
    .site-nav ul a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.95rem 0.15rem;
      font-family: var(--font-serif);
      font-size: 1.32rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-transform: none;
      color: var(--espresso);
      border-bottom: 0;
    }

    .nav-chevron {
      display: inline-block;
      color: var(--blush);
      font-size: 1rem;
    }

    .site-nav ul a[aria-current] {
      color: var(--rose-deep);
    }

    .site-nav ul a[aria-current] .nav-chevron {
      color: var(--rose);
    }

    .site-nav ul a:active {
      color: var(--rose);
    }

    .nav-foot {
      margin-top: 1.3rem;
      padding-top: 1.3rem;
      border-top: 1px solid var(--gold-hairline);
      text-align: center;
    }

    .nav-cta {
      display: flex;
      width: 100%;
      justify-content: center;
    }

    .nav-foot .nav-note {
      display: block;
      margin: 0.85rem 0 0;
      font-size: 0.78rem;
      line-height: 1.5;
      color: var(--umber);
    }

    .nav-foot .nav-handle {
      display: inline-block;
      margin-top: 0.9rem;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--rose);
    }

    /* Links slide in behind the panel, one after another. */
    @media (prefers-reduced-motion: no-preference) {
      .site-nav.is-open {
        animation: nav-panel-in 220ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .site-nav.is-open li,
      .site-nav.is-open .nav-foot {
        animation: nav-item-in 320ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
        animation-delay: calc(var(--nav-index, 0) * 40ms + 60ms);
      }
    }
  }

  @keyframes nav-panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  // Stagger order for the open animation.
  nav?.querySelectorAll<HTMLElement>('li, .nav-foot').forEach((item, index) => {
    item.style.setProperty('--nav-index', String(index));
  });

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Tapping the page behind an open panel closes it.
  document.addEventListener('click', (event) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    const target = event.target as Node;
    if (nav?.contains(target) || toggle.contains(target)) return;
    setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
